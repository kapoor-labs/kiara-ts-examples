{
  "name": "kiara-ts-examples",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:parts:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=**/parts-finder.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test tests/parts-finder.test.ts",
    "test:business:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=**/business-demos.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test tests/business-demos.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "data:capacitors": "node scripts/import-capacitors.mjs",
    "data:retail": "node scripts/import-retail.mjs"
  },
  "dependencies": {
    "@kapoorlabs/kiara-ts": "file:vendor/kapoorlabs-kiara-ts-1.1.1-search.0.tgz",
    "monaco-editor": "^0.55.1",
    "papaparse": "^5.5.3"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.16"
    }
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
